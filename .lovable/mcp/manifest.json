{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://aparvgdelraynacisdrq.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "planeofut",
      "version": "0.2.0",
      "title": "PlaneoFUT"
    },
    "tools": [
      {
        "name": "list_exercises",
        "title": "List exercises",
        "description": "Find football practices in the signed-in coach's private library, including favourites and planning details.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "Optional text found in the exercise name or objective."
            },
            "favouritesOnly": {
              "type": "boolean",
              "description": "Return only exercises marked as favourites."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Maximum records to return (1-50, defaults to 20)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_exercise",
        "title": "Create exercise",
        "description": "Create a complete football practice in the signed-in coach's library for later session planning.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "Clear football practice name."
            },
            "objective": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600,
              "description": "Coaching objective or intended outcome."
            },
            "durationMinutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 240,
              "description": "Planned duration in minutes (1-240)."
            },
            "playersCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 40,
              "description": "Recommended number of players (1-40)."
            },
            "space": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "Pitch dimensions or working area."
            },
            "materials": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600,
              "description": "Required equipment."
            },
            "observations": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "Organisation, coaching points and constraints."
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30
              },
              "maxItems": 20,
              "description": "Short searchable labels (max 20)."
            },
            "favourite": {
              "type": "boolean",
              "description": "Mark the exercise as a favourite."
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_exercise",
        "title": "Update exercise",
        "description": "Update fields of an existing practice in the coach's library, storing a version snapshot before the change.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "exerciseId": {
              "type": "string",
              "format": "uuid",
              "description": "Identifier of the exercise to update."
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "New practice name."
            },
            "objective": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 600
                },
                {
                  "type": "null"
                }
              ],
              "description": "New coaching objective; pass null to clear."
            },
            "durationMinutes": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 240
                },
                {
                  "type": "null"
                }
              ],
              "description": "New duration in minutes."
            },
            "playersCount": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 40
                },
                {
                  "type": "null"
                }
              ],
              "description": "New recommended player count."
            },
            "space": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                {
                  "type": "null"
                }
              ],
              "description": "New working area."
            },
            "materials": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 600
                },
                {
                  "type": "null"
                }
              ],
              "description": "New equipment list."
            },
            "observations": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                {
                  "type": "null"
                }
              ],
              "description": "New coaching points."
            },
            "intensity": {
              "type": "string",
              "enum": [
                "baja",
                "media",
                "alta",
                "muy_alta"
              ],
              "description": "New intensity: baja, media, alta or muy_alta."
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30
              },
              "maxItems": 20,
              "description": "Replacement list of labels."
            },
            "favourite": {
              "type": "boolean",
              "description": "Mark or unmark as favourite."
            }
          },
          "required": [
            "exerciseId"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_sessions",
        "title": "List sessions",
        "description": "List the signed-in coach's football training sessions with objectives, dates, load and evaluation details.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "fromDate": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Optional inclusive start date in YYYY-MM-DD format."
            },
            "toDate": {
              "$ref": "#/properties/fromDate",
              "description": "Optional inclusive end date in YYYY-MM-DD format."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Maximum records to return (1-50, defaults to 20)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_session",
        "title": "Create session",
        "description": "Create a football training session for the signed-in coach with its date, objective and planned load.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "Session name."
            },
            "objective": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600,
              "description": "Main coaching objective."
            },
            "sessionDate": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Planned date in YYYY-MM-DD format."
            },
            "durationMinutes": {
              "type": "integer",
              "minimum": 15,
              "maximum": 240,
              "description": "Total planned duration in minutes (15-240)."
            },
            "intensity": {
              "type": "string",
              "enum": [
                "baja",
                "media",
                "alta",
                "muy_alta"
              ],
              "description": "Planned session intensity: baja, media, alta or muy_alta."
            },
            "weeklyFocus": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "description": "Weekly tactical or physical focus."
            },
            "notes": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "Organisation and coaching notes."
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_session",
        "title": "Update session",
        "description": "Update an existing training session (date, objective, load or notes), storing a version snapshot first.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "sessionId": {
              "type": "string",
              "format": "uuid",
              "description": "Identifier of the session to update."
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "New session name."
            },
            "objective": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 600
                },
                {
                  "type": "null"
                }
              ],
              "description": "New main objective; pass null to clear."
            },
            "sessionDate": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "New planned date in YYYY-MM-DD format."
            },
            "durationMinutes": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 15,
                  "maximum": 240
                },
                {
                  "type": "null"
                }
              ],
              "description": "New duration in minutes."
            },
            "intensity": {
              "type": "string",
              "enum": [
                "baja",
                "media",
                "alta",
                "muy_alta"
              ],
              "description": "New intensity: baja, media, alta or muy_alta."
            },
            "weeklyFocus": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                {
                  "type": "null"
                }
              ],
              "description": "New weekly focus."
            },
            "notes": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                {
                  "type": "null"
                }
              ],
              "description": "New coaching notes."
            },
            "evaluation": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                {
                  "type": "null"
                }
              ],
              "description": "Post-session evaluation summary."
            }
          },
          "required": [
            "sessionId"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_microcycles",
        "title": "List microcycles",
        "description": "List weekly football microcycles and their MD slots for the signed-in coach.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "fromWeek": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Optional earliest week start in YYYY-MM-DD format."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "description": "Maximum records to return (1-20, defaults to 10)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_microcycle",
        "title": "Create microcycle",
        "description": "Create a weekly football microcycle and its MD-4 to match-day planning slots for the signed-in coach.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "Microcycle name."
            },
            "weekStart": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "First planning date in YYYY-MM-DD format."
            },
            "matchDay": {
              "type": "string",
              "enum": [
                "sabado",
                "domingo"
              ],
              "description": "Whether the competitive fixture is on Saturday or Sunday."
            },
            "weeklyObjective": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600,
              "description": "Primary outcome for the week."
            },
            "notes": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "Context, constraints or load notes."
            }
          },
          "required": [
            "name",
            "weekStart",
            "matchDay"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_microcycle",
        "title": "Update microcycle",
        "description": "Update a weekly microcycle header and optionally assign a session to one of its MD slots.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "microcycleId": {
              "type": "string",
              "format": "uuid",
              "description": "Identifier of the microcycle to update."
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "New microcycle name."
            },
            "weekStart": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "New first planning date in YYYY-MM-DD format."
            },
            "matchDay": {
              "type": "string",
              "enum": [
                "sabado",
                "domingo"
              ],
              "description": "New fixture day."
            },
            "weeklyObjective": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 600
                },
                {
                  "type": "null"
                }
              ],
              "description": "New weekly objective; pass null to clear."
            },
            "notes": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                {
                  "type": "null"
                }
              ],
              "description": "New notes; pass null to clear."
            },
            "assignSession": {
              "type": "object",
              "properties": {
                "slotType": {
                  "type": "string",
                  "enum": [
                    "MD-4",
                    "MD-3",
                    "MD-2",
                    "MD-1",
                    "MD"
                  ],
                  "description": "Slot to fill."
                },
                "sessionId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uuid"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Session to assign, or null to clear the slot."
                }
              },
              "required": [
                "slotType",
                "sessionId"
              ],
              "additionalProperties": false,
              "description": "Optionally assign or clear a training session in one planning slot."
            }
          },
          "required": [
            "microcycleId"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "duplicate_record",
        "title": "Duplicate exercise, session or microcycle",
        "description": "Clone a practice, session or weekly microcycle owned by the coach, optionally renaming it or shifting its dates.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "entity": {
              "type": "string",
              "enum": [
                "exercise",
                "session",
                "microcycle"
              ],
              "description": "What to duplicate: exercise, session or microcycle."
            },
            "recordId": {
              "type": "string",
              "format": "uuid",
              "description": "Identifier of the record to duplicate."
            },
            "newName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "Name for the copy; defaults to the original plus a copy suffix."
            },
            "shiftDays": {
              "type": "integer",
              "minimum": -365,
              "maximum": 365,
              "description": "Shift every date in the copy by this number of days."
            },
            "newDate": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Explicit date for the copy (sessions and microcycles)."
            }
          },
          "required": [
            "entity",
            "recordId"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_versions",
        "title": "List version history",
        "description": "List stored version snapshots for one of the coach's practices, sessions or microcycles.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "entity": {
              "type": "string",
              "enum": [
                "exercise",
                "session",
                "microcycle"
              ],
              "description": "Record type: exercise, session or microcycle."
            },
            "recordId": {
              "type": "string",
              "format": "uuid",
              "description": "Identifier of the record."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Maximum records to return (1-50, defaults to 20)."
            }
          },
          "required": [
            "entity",
            "recordId"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "restore_version",
        "title": "Restore a previous version",
        "description": "Roll a practice, session or microcycle back to a stored version snapshot, keeping the current state as a new version.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "entity": {
              "type": "string",
              "enum": [
                "exercise",
                "session",
                "microcycle"
              ],
              "description": "Record type: exercise, session or microcycle."
            },
            "recordId": {
              "type": "string",
              "format": "uuid",
              "description": "Identifier of the record to roll back."
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "description": "Version number to restore."
            }
          },
          "required": [
            "entity",
            "recordId",
            "version"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
