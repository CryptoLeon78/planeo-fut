{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "planeofut",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "logs": { "enabled": true }
  },
  "env": {
    "staging": {
      "name": "planeofut-staging"
    },
    "production": {
      "name": "planeofut-production"
    }
  }
}
